# ============================================================
# ARCHIVO .env — SOLO PARA USO LOCAL
# ¡¡NO SUBAS ESTE ARCHIVO A GITHUB!!
# Copia este archivo como .env y llena los valores
# ============================================================

# Flask
SECRET_KEY=pon_aqui_una_frase_larga_y_aleatoria
FLASK_DEBUG=False

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=mydb

# Token de autenticación para el Arduino
ARDUINO_TOKEN=pon_aqui_tu_token_secreto

# Correo (verificación de registro y restablecimiento de contraseña)
# Usa un servicio SMTP dedicado (Brevo, SendGrid, etc.), NO un correo Gmail personal.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=pon_aqui_tu_usuario_smtp
EMAIL_HOST_PASSWORD=pon_aqui_tu_password_o_api_key_smtp
DEFAULT_FROM_EMAIL=noreply@tudominio.com
CODIGO_EXP_MINUTOS=15
